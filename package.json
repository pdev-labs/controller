{
  "name": "psp-controller",
  "version": "0.1.5",
  "description": "PSP Controller App",
  "author": "pdev <pdev@example.com>",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-appimage": "electron-builder --linux AppImage",
    "build-linux": "electron-builder --linux"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "cordova": "^13.0.0",
    "cordova-plugin-networkinterface": "^2.2.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.psp.controller",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    },
    "deb": {
      "afterInstall": "build/linux/postinst"
    },
    "rpm": {
      "afterInstall": "build/linux/postinst"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "asarUnpack": [
      "dist/virtual_joystick*"
    ],
    "files": [
      "**/*",
      "!venv${/*}",
      "!virtual_joystick.py",
      "!virtual_joystick.spec",
      "!build${/*}",
      "!install.sh",
      "!setup.sh"
    ]
  }
}
